# Backend (FastAPI). Export these in the environment of the process; defaults shown.
IHATEFILE_MAX_UPLOAD_MB=20
IHATEFILE_JOB_TTL_SECONDS=600
IHATEFILE_CONVERT_TIMEOUT_SECONDS=120
IHATEFILE_MAX_CONCURRENT_JOBS=2
IHATEFILE_RATE_LIMIT_PER_MINUTE=20
IHATEFILE_MAX_ARCHIVE_ENTRIES=1000
IHATEFILE_MAX_EXPANDED_MB=200
IHATEFILE_MAX_OUTPUT_MB=200
IHATEFILE_MAX_AUDIO_SECONDS=1800
IHATEFILE_MAX_VIDEO_SECONDS=600
IHATEFILE_MAX_PDF_PAGES=50
IHATEFILE_MAX_OCR_PAGES=20

# Comma-separated list of exact origins allowed to call the API from a browser.
# In production set this to your frontend origin(s), e.g. https://ihatefile.pages.dev
IHATEFILE_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Set to true ONLY behind a trusted reverse proxy that sets X-Forwarded-For (needed for per-IP limits).
IHATEFILE_TRUST_PROXY_HEADERS=false
# How many proxies in front of the app append to X-Forwarded-For. The address that many entries from the RIGHT is used
# (left-most entries are written by the client and are never trusted). Too low = users share a bucket; too high = spoofable.
IHATEFILE_TRUSTED_PROXY_HOPS=1
# /api/docs and /api/openapi.json are off unless this is true.
# IHATEFILE_ENABLE_DOCS=false

# Optional overrides
# IHATEFILE_TMP_ROOT=/tmp/ihatefile
# IHATEFILE_REGISTRY_PATH=/app/shared/registry.json
