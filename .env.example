# Frontend (Vite). Copy to .env.local for local overrides. Never put secrets here: VITE_* values are public.

# Base URL of the conversion API. Leave empty in development (Vite proxies /api to
# http://127.0.0.1:8000) and when the API is served from the same origin.
# For a static host + separate API host set the full origin, e.g. https://api.example.com
VITE_API_BASE_URL=

# Only when the site is served from a sub-path (e.g. GitHub Pages project site): /repo-name/
VITE_BASE=/

# Optional: link used by the footer's "Support / feedback" item (issue tracker or contact page).
VITE_SUPPORT_URL=
